# Copy to .env and fill in. Never commit .env.

# Required. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Signs JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-real-one

# Matches docker-compose.yml
DATABASE_URL=postgresql+psycopg://talentscout:talentscout@localhost:5432/talentscout

ENVIRONMENT=local
DEBUG=false

LOG_LEVEL=INFO
LOG_JSON=false

# Vite dev server
CORS_ORIGINS=["http://localhost:5173"]
